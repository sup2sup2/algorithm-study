import java.io.BufferedReader;
import java.io.IOException;
import java.io.InputStreamReader;
import java.util.StringTokenizer;

class Solution{
	static int n, m;
	static int[][] map;
	static int[][] seedCnt;
	static int max;
	
	
	static int[] dr = {0,1,0,-1};
	static int[] dc = {1,0,-1,0};
	static int[] dircal = {1,0,-1,-2};
	
	
	static void dfs(int r, int c, int direct, int cnt, int gome) {
		if(cnt == m+1) {
			max = Math.max(gome, max);
//			System.out.println(r +" "+ c +" "+direct + " " + max);
			return;
		}
		
		for(int i = 0; i < n; i++) {
			for(int j = 0; j < n; j++) {
				if(map[i][j] <= 1) {
					continue;
				}
				
				map[i][j]--;
			}
		}
		
		boolean movable = false;
		for(int i = 0; i < 4; i++) {
			int curdir = direct + dircal[i];
			if(curdir>3) curdir-=4;
			if(curdir<0) curdir+=4;
			int nr = r + dr[curdir];
			int nc = c + dc[curdir];
			if(map[nr][nc] == 0 || map[nr][nc] == 1) {
				movable = true;
				direct = curdir;
				break;
			}
		}
		
		if(movable) {
			if(map[r][c] == 0) {
				map[r][c] = 3 + (seedCnt[r][c]+1) + 2;
				seedCnt[r][c]++;
			}
			else if(map[r][c] == 1) {
				gome++;
				map[r][c] = 0;
			}
			dfs(r+dr[direct], c+dc[direct], direct, cnt+1, gome);
		} else {
			if(map[r][c] == 1) {
				gome++;
				map[r][c] = 0;
			}
			dfs(r, c, direct, cnt+1, gome);
		}
	}
	
	
	public static void main(String[] args) throws Exception {
		BufferedReader br = new BufferedReader(new InputStreamReader(System.in));
		StringBuilder sb = new StringBuilder();
		StringTokenizer st;
		
		int T = Integer.parseInt(br.readLine());
		
		
		
		for(int t = 1; t <= T; t++) {
			st = new StringTokenizer(br.readLine());
			n = Integer.parseInt(st.nextToken());
			m = Integer.parseInt(st.nextToken());
			
			map = new int[n][n];
			seedCnt = new int[n][n];
			for(int i = 0; i < n; i++) {
				st = new StringTokenizer(br.readLine());
				for(int j = 0; j < n; j++) {
					int a = Integer.parseInt(st.nextToken());
					if(a == 1) {
						a = -1;
					}
					
					map[i][j] = a;
					seedCnt[i][j] = a;
				}
			}
			max = 0;
			
			
			for(int i = 0; i < n; i++) {
				for(int j = 0; j < n; j++) {
					if(map[i][j] == -1) continue;
					for(int k = 0; k < 4; k++) {
						int gome = 0;
						int cnt = 1;
						for(int c = 0; c < n; c++) {
							for(int d = 0; d < n; d++) {
								if(seedCnt[c][d] <= 0) {
									continue;
								}
								seedCnt[c][d] = 0;
							}
						}
						for(int c = 0; c < n; c++) {
							for(int d = 0; d < n; d++) {
								if(map[c][d] <= 0) {
									continue;
								}
								map[c][d] = 0;
							}
						}
						dfs(i, j, k, cnt, gome);
					}
				}
			}
			sb.append("#").append(t).append(" ").append(max).append("\n");
			
		}
		System.out.println(sb);
	
	
	
	}
}
