
import java.io.BufferedReader;
import java.io.IOException;
import java.io.InputStreamReader;
import java.util.StringTokenizer;

public class Solution {
	static int n;
	static int[][] map;
	static int[] coreX;
	static int[] coreY;
	static int coreMax;
	static int lengthMin;
	
	static int corecnt;
	
	static int[] dx = {0, 0, 1, -1};
	static int[] dy = {1, -1, 0, 0};
	
	static boolean[] visited;
	
	static void dfs(int index, int connected, int sum) {

	    // 모든 코어 확인 완료
	    if(index == corecnt) {

	        if(connected > coreMax) {
	            coreMax = connected;
	            lengthMin = sum;
	        }
	        else if(connected == coreMax) {
	            lengthMin = Math.min(lengthMin, sum);
	        }

	        return;
	    }

	    int curX = coreX[index];
	    int curY = coreY[index];

	    // 4방향 연결 시도
	    for(int i = 0; i < 4; i++) {

	        int fx = curX + dx[i];
	        int fy = curY + dy[i];

	        boolean possible = true;

	        // 끝까지 갈 수 있는지 먼저 확인
	        while(fx >= 0 && fx < n && fy >= 0 && fy < n) {

	            if(map[fx][fy] != 0) {
	                possible = false;
	                break;
	            }

	            fx += dx[i];
	            fy += dy[i];
	        }

	        if(possible) {

	            int nx = curX + dx[i];
	            int ny = curY + dy[i];

	            int cnt = 0;

	            // 전선 설치
	            while(nx >= 0 && nx < n && ny >= 0 && ny < n) {

	                map[nx][ny] = 2;

	                cnt++;

	                nx += dx[i];
	                ny += dy[i];
	            }

	            // 다음 코어
	            dfs(index + 1, connected + 1, sum + cnt);


	            // ===== 백트래킹 =====

	            nx = curX + dx[i];
	            ny = curY + dy[i];

	            while(nx >= 0 && nx < n && ny >= 0 && ny < n) {

	                map[nx][ny] = 0;

	                nx += dx[i];
	                ny += dy[i];
	            }
	        }
	    }


	    // 현재 코어를 연결하지 않는 경우도 반드시 탐색
	    dfs(index + 1, connected, sum);
	}
	
	
	public static void main(String[] args) throws Exception {
		BufferedReader br = new BufferedReader(new InputStreamReader(System.in));
		StringBuilder sb = new StringBuilder();
		int T = Integer.parseInt(br.readLine());
		
		for(int t = 1; t <= T; t++) {
			n = Integer.parseInt(br.readLine());
			map = new int[n][n];
			corecnt = 0;
			coreMax = 0;
			lengthMin = Integer.MAX_VALUE; 
					
			coreX = new int[13];
			coreY = new int[13];
			visited = new boolean[13];
			
			
			
			int index = 1;
			
			for(int i = 0; i < n; i++) {
				StringTokenizer st = new StringTokenizer(br.readLine());
				for(int j = 0; j < n; j++) {
					map[i][j] = Integer.parseInt(st.nextToken());
					if(map[i][j] == 1 && i > 0 && i < n - 1 && j > 0 && j < n - 1) {
					    coreX[corecnt] = i;
					    coreY[corecnt] = j;
					    corecnt++;
					}
				}
			}
			
			dfs(0, 0, 0);
			
			sb.append("#").append(t).append(" ").append(lengthMin).append("\n");
			
		}
		System.out.print(sb);
	}

}