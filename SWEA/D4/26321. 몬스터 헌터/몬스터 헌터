import java.io.BufferedReader;
import java.io.InputStreamReader;
import java.util.StringTokenizer;



public class Solution {	
	static int n;
	static int[][] map;
	static int[] plusX;
	static int[] plusY;
	static int[] minusX;
	static int[] minusY;
	
	
	static boolean[] checkP;
	static boolean[] checkM;
	
	static int m;
	static int min;
	
	static void dfs(int curX, int curY, int preX, int preY, int time, int cnt) {
		
		int c = 0;
		c += Math.max(curX, preX) - Math.min(curX, preX);
		c += Math.max(curY, preY) - Math.min(curY, preY);
		time += c;
		if(cnt == m) {
			min = Math.min(min, time);
			return;
		}
		for(int i = 1; i <= 4; i++) {
			if(plusX[i] >= 0) {
				if(!checkP[i]) {
					checkP[i] = true; 
					dfs(plusX[i], plusY[i], curX, curY, time, cnt);
					checkP[i] = false;
				}
				if(checkP[i] && !checkM[i]) {
					checkM[i] = true;
					dfs(minusX[i], minusY[i], curX, curY, time, cnt+1);
					checkM[i] = false;
				}
			}
		}


		
	}
	
 	public static void main(String args[]) throws Exception
	{
		BufferedReader br = new BufferedReader(new InputStreamReader(System.in));
		int T = Integer.parseInt(br.readLine());
		StringBuilder sb = new StringBuilder();
		for(int t = 1; t <= T; t++) {
			n = Integer.parseInt(br.readLine());
			
			map = new int[n][n];
			
			plusX = new int[5];
			plusY = new int[5];
			minusX = new int[5];
			minusY = new int[5];
			
			for(int i = 0; i < 5; i++) {
				plusX[i] = -1;
				plusY[i] = -1;
				minusX[i] = -1;
				minusY[i] = -1;
			}
			m = 0;
			min = Integer.MAX_VALUE;
			
			for(int i = 0; i < n; i++) {
				StringTokenizer st = new StringTokenizer(br.readLine());
				for(int j = 0; j < n; j++) {
					map[i][j] = Integer.parseInt(st.nextToken());
					if(map[i][j] > 0 ) {
						plusX[map[i][j]] = i;
						plusY[map[i][j]] = j;
						m++;
					}
					if(map[i][j] < 0) {
						minusX[-1*map[i][j]] = i;
						minusY[-1*map[i][j]] = j;
					}
				}
			}

			
			checkP = new boolean[5];
			checkM = new boolean[5];
			
			for(int i = 1; i <= 4; i++) {
				if(plusX[i] >= 0) {
					dfs(plusX[i], plusY[i], 0, 0, 0, 0);
				}
			}
			
			
			
			sb.append("#").append(t).append(" ").append(min).append("\n");
				
		}
		System.out.print(sb);
		
	}
}
