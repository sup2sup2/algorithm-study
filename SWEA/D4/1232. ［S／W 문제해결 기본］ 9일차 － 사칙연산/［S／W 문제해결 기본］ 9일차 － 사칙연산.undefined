

import java.io.BufferedReader;
import java.io.InputStreamReader;
import java.util.StringTokenizer;

public class Solution {
    static int n;
    static char[] op;      
    static int[] val;   
    static int[] left, right;

    static int eval(int node) {
        if (op[node] == 0) {
            return val[node]; 
        }
        int l = eval(left[node]);
        int r = eval(right[node]);
        switch (op[node]) {
            case '+': return l + r;
            case '-': return l - r;
            case '*': return l * r;
            case '/': return l / r;
        }
        return 0;     }

    public static void main(String args[]) throws Exception {
        BufferedReader br = new BufferedReader(new InputStreamReader(System.in));
        int T = 10;
        StringBuilder sb = new StringBuilder();

        for (int t = 1; t <= T; t++) {
            n = Integer.parseInt(br.readLine().trim());

            op = new char[n + 1];
            val = new int[n + 1];
            left = new int[n + 1];
            right = new int[n + 1];

            for (int i = 0; i < n; i++) {
                String s = br.readLine();
                StringTokenizer st = new StringTokenizer(s);
                int a = Integer.parseInt(st.nextToken());
                String second = st.nextToken();

               
                char c = second.charAt(0);
                if (c == '+' || c == '-' || c == '*' || c == '/') {
                    op[a] = c;
                    left[a] = Integer.parseInt(st.nextToken());
                    right[a] = Integer.parseInt(st.nextToken());
                } else {
                    op[a] = 0;
                    val[a] = Integer.parseInt(second);
                }
            }

            int result = eval(1);
            sb.append("#").append(t).append(" ").append((int) result).append("\n");
        }

        System.out.print(sb);
    }
}